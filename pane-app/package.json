{
  "name": "pane",
  "version": "0.4.92",
  "description": "The lightest IDE ever built",
  "main": "./out/main/index.js",
  "author": "Aslam Abdul",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "electron-vite build && node scripts/copy-compiled.mjs",
    "preview": "electron-vite preview",
    "build:mac": "npm update @anthropic-ai/claude-agent-sdk && npm run build && electron-builder --mac --arm64 && npm run version:patch",
    "build:all": "npm update @anthropic-ai/claude-agent-sdk && npm run build && electron-builder --mac --arm64 --x64",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/renderer/",
    "build:icon": "node scripts/build-icon.mjs",
    "download-models": "node scripts/download-models.mjs",
    "postinstall": "electron-rebuild -f --only node-pty,better-sqlite3"
  },
  "build": {
    "appId": "com.pane.ide",
    "productName": "Pane",
    "mac": {
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "CFBundleIconName": "AppIcon"
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "protocols": [
        {
          "name": "Pane",
          "schemes": [
            "pane"
          ]
        }
      ]
    },
    "extraResources": [
      {
        "from": "build/Assets.car",
        "to": "Assets.car"
      },
      {
        "from": "models/",
        "to": "models",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "out/**/*",
      "src/main/main.mjs",
      "src/main/model-manager.mjs",
      "src/main/model-paths.mjs",
      "src/main/cli-worker.mjs",
      "src/main/pty-worker.mjs",
      "src/main/pane-mcp-server.mjs",
      "src/main/brain-engine.mjs",
      "src/main/punk-engine.mjs",
      "src/main/http-backend.mjs",
      "src/main/context-manager.mjs",
      "src/main/session-context.mjs",
      "src/main/tool-executor.mjs",
      "src/main/classify-intent.mjs",
      "src/main/intent-classifier.mjs",
      "src/main/planning-agent.mjs",
      "src/main/punk-backend.mjs",
      "src/main/task-runner.mjs",
      "src/main/backup-engine.mjs",
      "src/main/cloud-auth.mjs",
      "src/main/cloud-crypto.mjs",
      "src/main/cloud-sync.mjs",
      "src/preload/preload.mjs",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**",
      "node_modules/better-sqlite3/**",
      "node_modules/@anthropic-ai/claude-agent-sdk/**"
    ],
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.77",
    "@fontsource-variable/bricolage-grotesque": "^5.2.10",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.7",
    "@fontsource/geist-mono": "^5.2.7",
    "@huggingface/transformers": "^3.8.1",
    "ace-builds": "^1.40.8",
    "better-sqlite3": "^12.6.2",
    "chokidar": "^5.0.0",
    "electron-window-state": "^5.0.3",
    "framer-motion": "^12.38.0",
    "fuse.js": "^7.1.0",
    "glob": "^11.0.0",
    "ignore": "^7.0.5",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-ace": "^12.0.0",
    "react-dom": "^18.3.1",
    "strip-ansi": "^7.1.2",
    "zustand": "^5.0.0"
  },
  "overrides": {
    "isbinaryfile": "^6.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.24",
    "electron": "^40.6.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.3.0",
    "eslint": "^10.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^5.4.11"
  }
}
