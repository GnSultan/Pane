{
  "name": "pane-cloud",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create pane-cloud",
    "db:migrate": "wrangler d1 execute pane-cloud --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute pane-cloud --remote --file=./schema.sql",
    "r2:create": "wrangler r2 bucket create pane-backups",
    "secret:github": "wrangler secret put GITHUB_CLIENT_SECRET",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250327.0",
    "typescript": "^5.7.3",
    "wrangler": "^4.0.0"
  }
}
